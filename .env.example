# ============================================================================
# CẤU HÌNH KẾT NỐI GIỮA GIAO DIỆN TED (PYSIDE6) VÀ NÃO BỘ AI
# Copy file này thành `.env` để tùy chỉnh theo môi trường của bạn
# ============================================================================

# Nhân vật đồng hành mặc định: "cat" (Mèo), "owl" (Cú đêm), "panda" (Gấu trúc), "shiba", "bunny", "penguin"
TED_CHARACTER_SKIN=cat

# Ngôn ngữ hiển thị giao diện: "vi" (Tiếng Việt) hoặc "en" (English)
TED_LANGUAGE=vi

# Chế độ kết nối: "local" (AI chạy trên cùng máy tính) hoặc "vps" (AI chạy trên VPS)
TED_CONNECTION_MODE=local

# Cấu hình phiên tập trung mặc định
DEFAULT_POMODORO_MINUTES=25
DEFAULT_SHORT_BREAK_MINUTES=5
MINDFUL_PING_INTERVAL_MINUTES=15

# ============================================================================
# CẤU HÌNH GIỌNG NÓI: TTS (TEXT-TO-SPEECH) & STT (SPEECH-TO-TEXT)
# ============================================================================

# --- 1. TTS (Text-to-Speech: Ted đọc câu trả lời) ---
# Bật/tắt đọc giọng nói: true / false
TED_TTS_ENABLED=false

# Chế độ TTS: "auto" (dùng giọng offline đã tải nếu có, nếu không dùng server), "embedded" (offline), hoặc "server"
# Giọng offline KHÔNG có sẵn trong bộ cài: vào Cài đặt → "Tải / quản lý giọng đọc offline…" để chọn & tải (lưu ở ~/.ted/voice_models)
TED_TTS_MODE=auto

# Địa chỉ máy chủ TTS (khi chạy chế độ server, tương thích chuẩn OpenAI /v1/audio/speech)
# Có thể dùng: Kokoro-FastAPI, Piper-HTTP server, XTTS server, hoặc OpenAI Audio API
TED_TTS_SERVER_URL=http://127.0.0.1:8880/v1
TED_TTS_API_KEY=

# Tên model TTS trên server
TED_TTS_MODEL=tts-1

# Cấu hình giọng chuẩn cho Tiếng Việt & Tiếng Anh
# Tiếng Việt: vi-VN-Standard-A, vi-VN-Standard-B, vi-VN-Wavenet-A, vi_female, vi_male
TED_TTS_VOICE_VI=vi-VN-Standard-A
# Tiếng Anh: en-US-Standard-C, alloy, echo, fable, onyx, nova, shimmer, en_female
TED_TTS_VOICE_EN=en-US-Standard-C

# Tốc độ đọc (0.5 đến 2.0, mặc định 1.0)
TED_TTS_SPEED=1.0

# --- 2. STT (Speech-to-Text: Nhập liệu bằng giọng nói qua Mic) ---
# Bật/tắt nhận dạng giọng nói: true / false
TED_STT_ENABLED=false

# Chế độ STT: "auto" (dùng mô hình whisper.cpp đã tải nếu có, nếu không dùng server), "embedded", hoặc "server"
# Mô hình offline tải trong Cài đặt → "Tải / quản lý mô hình nhận giọng nói…" (macOS cần: brew install whisper-cpp)
TED_STT_MODE=auto

# Địa chỉ máy chủ STT (chuẩn OpenAI /v1/audio/transcriptions, ví dụ Faster-Whisper server)
TED_STT_SERVER_URL=http://127.0.0.1:8881/v1
TED_STT_API_KEY=

# Tên model STT (whisper-1, tiny, base, small, medium)
TED_STT_MODEL=whisper-1

# ============================================================================
# CẤU HÌNH CẬP NHẬT ỨNG DỤNG TỰ ĐỘNG (AUTO-UPDATE)
# ============================================================================
# URL file kê khai cập nhật version.json (mặc định lấy từ DEFAULT_UPDATE_URL nếu không khai báo)
TED_UPDATE_URL=https://file5.bkglobal.vn/techbkglobal/release/version.json
